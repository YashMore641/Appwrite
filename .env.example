# Appwrite Project Configuration for RecallX
# Replace the placeholder values with your Appwrite project details

# Appwrite API Endpoint (e.g., https://cloud.appwrite.io/v1 or your self-hosted URL)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite Project ID (Found in Project Settings)
VITE_APPWRITE_PROJECT_ID=your_project_id_here

# Appwrite TablesDB / Database ID
VITE_APPWRITE_DATABASE_ID=recallx_db

# Appwrite Table / Collection ID for Memories
VITE_APPWRITE_TABLE_ID=memories

# Appwrite Storage Bucket ID for screenshots, images, and PDFs
VITE_APPWRITE_BUCKET_ID=memories_vault
